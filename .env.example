# Copie este arquivo para ".env" e preencha. NUNCA faça commit do ".env".
# Use SOMENTE a chave "anon" (public). Jamais a "service_role".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-public

# Local: deixe "/". Produção (GitHub Pages): "/nome-do-repositorio/"
VITE_BASE_PATH=/
